{
  "hosting": {
    "public": "hosting",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "billcheck-api",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
