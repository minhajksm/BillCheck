# Copy to api/.env and fill in. api/.env is gitignored; never commit it.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://billcheck:billcheck@localhost:5432/billcheck

# Signs OTP hashes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me

# "console" prints OTP codes in this terminal instead of sending SMS.
OTP_DELIVERY=console

# Browser origins allowed to call the API (Expo web dev server).
CORS_ORIGINS=["http://localhost:8081"]
