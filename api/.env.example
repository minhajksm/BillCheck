# Copy to api/.env and fill in. api/.env is gitignored; never commit it.

ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Supabase hosts it, so nothing runs locally. In the dashboard: Connect ->
# "Session pooler", and copy the URI. Then change the scheme it gives you from
# "postgresql://" to "postgresql+psycopg://", which is the driver we use.
#
# Session pooler (port 5432) is the one for a long-running server like this.
# The transaction pooler (6543) works too and is meant for serverless. The
# direct connection (db.<ref>.supabase.co) is IPv6-only on most projects, so
# it fails from a home network without the IPv4 add-on.
#
# If the password has @ : / ? # or % in it, percent-encode those characters,
# or the URL will be read wrong. Resetting it to something alphanumeric in
# Database -> Settings is easier.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Postgres in Docker on this machine instead, for working offline. See
# "Running Postgres locally instead" in README.md.
# DATABASE_URL=postgresql+psycopg://billcheck:billcheck@localhost:5432/billcheck

# Signs OTP hashes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me

# "console" prints OTP codes in this terminal instead of sending SMS.
OTP_DELIVERY=console

# Browser origins allowed to call the API (Expo web dev server).
CORS_ORIGINS=["http://localhost:8081"]

# --- Reading bills ----------------------------------------------------------
# OCR_PROVIDER=claude reads real pages with Claude; "stub" (the default)
# returns one fixed sample bill and needs no key.
#
# ANTHROPIC_API_KEY=
# OCR_MODEL=claude-sonnet-5-5
# How hard the reader thinks: low | medium | high | xhigh | max.
# OCR_EFFORT=medium

# --- SMS delivery -----------------------------------------------------------
# OTP_DELIVERY=msg91 sends real SMS through MSG91. It needs a DLT-approved
# template; see "Sending real SMS" in README.md. Leave it on console until
# that template is approved.
#
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
#
# To exercise the MSG91 path without sending an SMS, run
# `uv run python scripts/fake_msg91.py` and point the API at it:
# MSG91_URL=http://localhost:8091/

# Bills one person can send to be read in 24 hours (each is a paid Claude call).
BILL_UPLOADS_PER_DAY=20
